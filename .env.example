# ---------------------------------------------------------------------------
# 100DaysAI YouTube Academy Tracking System (Django)
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=""
DEBUG="false"
ALLOWED_HOSTS="your-domain.com"
CSRF_TRUSTED_ORIGINS="https://your-domain.com"
TIME_ZONE="UTC"
LOG_LEVEL="INFO"

# --- Database (required) ---------------------------------------------------
DB_NAME="academy"
DB_USER="academy"
DB_PASSWORD=""
DB_HOST="localhost"
DB_PORT="5432"
DB_SSLMODE="require"
# Set true when DB_HOST is a connection pooler (Neon pooled, Supabase pgbouncer,
# PgBouncer). Disables server-side prepared statements and held cursors.
DB_POOLED="false"
DB_CONN_MAX_AGE="60"

# --- Encryption (required) -------------------------------------------------
# Encrypts OAuth refresh tokens, LMS credentials and TOTP secrets at rest.
# MUST decode to exactly 32 bytes. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Store it in a secret manager: losing it makes every stored OAuth token
# unrecoverable, and rotating it invalidates them.
ENCRYPTION_KEY=""

# --- Sessions and lockout --------------------------------------------------
SESSION_TTL_MINUTES="480"
MAX_FAILED_LOGIN_ATTEMPTS="8"
LOGIN_LOCKOUT_MINUTES="15"
SECURE_SSL_REDIRECT="true"
SECURE_HSTS_SECONDS="31536000"

# --- Background jobs -------------------------------------------------------
# Shared secret for POST /api/cron/<job>/, for hosts without a persistent
# worker. Send as: Authorization: Bearer <secret>
CRON_SECRET=""
Q_WORKERS="2"

# --- YouTube / Google OAuth ------------------------------------------------
# Google Cloud project with "YouTube Data API v3" and "YouTube Analytics API"
# enabled. Google verification is required before more than 100 students can
# grant consent — worth starting early, review takes weeks.
#
# YOUTUBE_API_KEY alone enables public figures (subscribers, views, uploads).
# The OAuth client is needed only for the private metrics: impressions, CTR,
# average view duration, retention, traffic sources and revenue.
#
# GOOGLE_OAUTH_REDIRECT_URI must match the authorized redirect URI on the OAuth
# client exactly, including the trailing slash.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="https://your-domain.com/api/oauth/youtube/callback/"
YOUTUBE_API_KEY=""
YOUTUBE_DAILY_QUOTA_UNITS="10000"
# Adds the monetary scope to the consent screen. Leave off unless the academy
# actually tracks student revenue.
YOUTUBE_TRACK_REVENUE="false"

# --- Notifications (optional) ----------------------------------------------
# Blank keys are not an error: the adapter records the notification as SKIPPED
# with the reason, and in-app delivery still works.
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL="academy@100daysai.example"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# --- Phase 2: LMS integration (optional) -----------------------------------
LMS_ADAPTER="MANUAL"
# Verifies HMAC-SHA256 signatures on the webhook receiver. Without it the
# endpoint refuses every request.
LMS_WEBHOOK_SECRET=""

# --- Uploads ---------------------------------------------------------------
FILE_MAX_UPLOAD_MB="25"
